  "sharpening_cadence": {
    "month_1": {
      "interval_days": 5,
      "rationale": "Fast correction of base behavior errors"
    },
    "month_2": {
      "interval_days": 10,
      "rationale": "Stabilization phase"
    },
    "month_3_plus": {
      "interval_days": 20,
      "rationale": "Mature agent — mostly maintenance"
    },
    "dip_override": {
      "enabled": true,
      "rationale": "Performance dip triggers override timer immediately"
    }
